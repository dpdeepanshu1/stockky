# ============================================
# Stockky Environment Variables
# ============================================

# ---- API Gateway ----
API_GATEWAY_PORT=8000

# ---- Service URLs (internal Docker / local) ----
# For local development with Docker Compose, use service names.
# For Render deployment, replace these with the public Render URLs.
MARKET_DATA_URL=http://market-data-service:8000
TECHNICAL_URL=http://technical-analysis-service:8001
FUNDAMENTAL_URL=http://fundamental-analysis-service:8002
NEWS_URL=http://news-intelligence-service:8003
EVENT_URL=http://event-tracker-service:8004
PREDICTION_URL=http://prediction-service:8005
DECISION_URL=http://decision-engine-service:8006
NOTIFICATION_URL=http://notification-service:8007
REPORT_URL=http://report-service:8008
MARKET_SENTIMENT_URL=http://market-sentiment-service:8009   # NEW
TRAINING_URL=http://training-service:8010                   # NEW

# ---- Redis (Upstash) ----
UPSTASH_REDIS_REST_URL="https://adapted-lion-167573.upstash.io"
UPSTASH_REDIS_REST_TOKEN="gQAAAAAAAo6VAAIgcDEzN2UwNWRkYmYwMWU0OWE4YjYxYjY1ZDQ5NWM2ZDgxMw"

# ---- Database (PostgreSQL) ----
# Primary user DB (if you have one – can be Supabase/Neon)
DATABASE_URL=postgresql://user:password@host:5432/stockky_db

# Training DB (use the same or a separate database; we'll create one in Supabase)
TRAINING_DATABASE_URL=postgresql://postgres:password@host:5432/training_db

# ---- Model Storage ----
# For Render, you can use ephemeral storage or a Render Disk.
# For now, we use a local path; on Render, you can set this to /app/model-store
MODEL_STORE_PATH=./data/training-model

# ---- Notification fallback (optional) ----
# DISCORD_WEBHOOK_URL=
# SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ---- API Keys (for other services) ----
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# ---- Frontend build variable ----
# This is baked into the frontend at build time.
VITE_API_URL=https://api-gateway-wizr.onrender.com